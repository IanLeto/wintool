# Kubernetes 配置文件示例
# 
# 使用说明:
# 1. 将此文件重命名为 kubeconfig (去掉 .example 后缀)
# 2. 填入你的实际集群配置信息
# 3. 确保 kubeconfig 文件与启动脚本在同一目录下
#
# 配置格式参考: https://kubernetes.io/docs/concepts/configuration/organize-cluster-access-kubeconfig/

apiVersion: v1
kind: Config
current-context: cluster-1

clusters:
- cluster:
    certificate-authority-data: <BASE64_ENCODED_CA_CERT>
    server: https://cluster1.example.com:6443
  name: cluster-1

- cluster:
    certificate-authority-data: <BASE64_ENCODED_CA_CERT>
    server: https://cluster2.example.com:6443
  name: cluster-2

contexts:
- context:
    cluster: cluster-1
    namespace: default
    user: admin
  name: cluster-1

- context:
    cluster: cluster-2
    namespace: default
    user: admin
  name: cluster-2

users:
- name: admin
  user:
    client-certificate-data: <BASE64_ENCODED_CLIENT_CERT>
    client-key-data: <BASE64_ENCODED_CLIENT_KEY>

# 或者使用 token 认证:
# users:
# - name: admin
#   user:
#     token: <YOUR_TOKEN>
